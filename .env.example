# Copy this file to .env.local and fill in your values
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@sundayharmony.com
SMTP_PASS=your-smtp-app-password
NOTIFY_EMAIL=sales@sundayharmony.com
NEXT_PUBLIC_SITE_URL=https://www.sundayharmony.com
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://sunday-harmony-site.vercel.app

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Monthly recurring Price IDs (Stripe Dashboard → Products → copy price_...)
STRIPE_PRICE_SOCIAL_ESSENTIALS=price_xxx
STRIPE_PRICE_SPARK=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_SCALE=price_xxx
# Optional: pin Customer Portal configuration (Stripe Dashboard → Billing → Customer portal)
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_xxx

# Google Places Discovery (Admin → Leads → Find Businesses)
# Set on Vercel (Production/Preview) as well as .env.local. In Google Cloud Console, enable "Places API (New)" for this key and ensure billing is active per Google's requirements.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
