# Copy this file to .env.local and fill in your values
# Email — Google Workspace SMTP (smtp.gmail.com + app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@sundayharmony.com
SMTP_PASS=your-google-app-password
# Optional display name for outbound mail (defaults to SMTP_USER)
SMTP_FROM_EMAIL=Sunday Harmony <sales@sundayharmony.com>
NOTIFY_EMAIL=sales@sundayharmony.com
# Inbound: contact form, client dashboard messages, client file uploads, and client approval decisions (alerts to your team). Must be a valid address.
NEXT_PUBLIC_SITE_URL=https://www.sundayharmony.com
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://sunday-harmony-site.vercel.app

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# Server-only secret key (sb_secret_...). Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy fallback, only if your project has not migrated to secret keys:
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Monthly recurring Price IDs (Stripe Dashboard → Products → copy price_...)
STRIPE_PRICE_SOCIAL_ESSENTIALS=price_xxx
STRIPE_PRICE_SPARK=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_SCALE=price_xxx
# Google Places Discovery (Admin → Leads → Find Businesses)
# Set on Vercel (Production/Preview) as well as .env.local. In Google Cloud Console, enable "Places API (New)" for this key and ensure billing is active per Google's requirements.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Marketing Graphics — Gemini image generation (Admin → Marketing Graphics → AI tab)
# Get a key: https://aistudio.google.com/apikey — enable billing for image models in Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override image model (default gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Credit & Funding — AES-256 encryption key for sensitive fields (32 bytes, base64-encoded).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDIT_FUNDING_ENCRYPTION_KEY=your-base64-32-byte-key
# Use a separate secret for invite/intake HMAC signing in production.
CREDIT_FUNDING_SIGNING_SECRET=
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Admin bootstrap (local/seed — used by setup route and initial admin user)
ADMIN_EMAIL=sales@sundayharmony.com
ADMIN_PASSWORD=change-me-in-production
# One-time setup route token (disable in production after use)
SETUP_TOKEN=

# Durable rate limiting (required for reliable limits on Vercel serverless)
# Without these, auth/contact/credit-funding limits are per-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dispute Letters — Python API on Railway (Admin → Dispute Letters)
# Vercel: set DISPUTE_LETTERS_API_URL + DISPUTE_LETTERS_API_SECRET
# Railway (services/dispute-letters-api): set CURSOR_API_KEY, same DISPUTE_LETTERS_API_SECRET, SUPABASE_URL, and a server-only Supabase secret key
DISPUTE_LETTERS_API_URL=https://your-railway-service.up.railway.app
DISPUTE_LETTERS_API_SECRET=generate-a-long-random-secret

# User roles (stored in Supabase users.role): admin | client | credit_manager
# credit_manager: scoped access to /admin/credit-funding and /admin/team-messages only
