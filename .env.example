# Copy this file to .env.local and fill in your values
# Email — Resend (preferred) or SMTP fallback
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Sunday Harmony <sales@sundayharmony.com>
# Resend inbound webhook signing secret (Dashboard → Webhooks → your endpoint)
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@sundayharmony.com
SMTP_PASS=your-smtp-app-password
NOTIFY_EMAIL=sales@sundayharmony.com
# Inbound: contact form, client dashboard messages, client file uploads, and client approval decisions (alerts to your team). Must be a valid address.
NEXT_PUBLIC_SITE_URL=https://www.sundayharmony.com
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://sunday-harmony-site.vercel.app

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Monthly recurring Price IDs (Stripe Dashboard → Products → copy price_...)
STRIPE_PRICE_SOCIAL_ESSENTIALS=price_xxx
STRIPE_PRICE_SPARK=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_SCALE=price_xxx
# Google Places Discovery (Admin → Leads → Find Businesses)
# Set on Vercel (Production/Preview) as well as .env.local. In Google Cloud Console, enable "Places API (New)" for this key and ensure billing is active per Google's requirements.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Credit & Funding — AES-256 encryption key for sensitive fields (32 bytes, base64-encoded).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDIT_FUNDING_ENCRYPTION_KEY=your-base64-32-byte-key
